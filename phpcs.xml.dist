<?xml version="1.0"?>
<ruleset name="WooCommerce Agent Tools">
	<description>WordPress and WooCommerce coding standards for this plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<!-- Analysis-only signatures for another plugin, deliberately mirroring its
	     namespaces and never loaded at runtime. -->
	<exclude-pattern>/stubs/</exclude-pattern>
	<!-- The test harness deliberately declares WordPress's own function names in the global
	     namespace, because that is what the code under test calls. Never loaded at runtime. -->
	<exclude-pattern>/tests/bootstrap.php</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- WooCommerce-Core is the real standard: it pulls in WooCommerce's own sniffs, the
	     full WordPress standard, PHPCompatibilityWP and Squiz.Commenting. -->
	<rule ref="WooCommerce-Core"/>

	<!-- Without these two the PHPCompatibility and WP-version sniffs that WooCommerce-Core
	     includes have nothing to compare against and silently pass everything. Both match
	     the plugin header. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.9"/>

	<!-- WooCommerce's own config adds these on top of the standard. -->
	<rule ref="Generic.PHP.RequireStrictTypes"/>
	<rule ref="Generic.Commenting.Todo"/>
	<rule ref="Generic.Commenting.Fixme"/>

	<!-- src/ is PSR-4, so the WordPress file-name sniffs cannot apply there. The two Squiz
	     sniffs replace them with a stricter rule: PascalCase class names matching their own
	     filename. Same swap WooCommerce core makes for its src/. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>src/</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>src/</exclude-pattern>
	</rule>
	<!-- tests/ is PSR-4-ish too, and a test's name is its documentation: a docblock per
	     test method would restate the method name and nothing more. The rest of the
	     standard still applies there. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>tests/</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>tests/</exclude-pattern>
	</rule>
	<rule ref="Squiz.Classes.ClassFileName">
		<include-pattern>src/</include-pattern>
	</rule>
	<rule ref="Squiz.Classes.ValidClassName">
		<include-pattern>src/</include-pattern>
	</rule>

	<!-- The bootstrap declares one global function and one global variable; namespaced
	     classes satisfy the sniff on their own. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wcat"/>
				<element value="WooCommerce\AgentTools"/>
				<element value="woocommerce_agent_tools"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woocommerce-agent-tools"/>
			</property>
		</properties>
	</rule>

	<!-- WooCommerce capabilities this plugin checks; the sniff knows only core's. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
